    <None Include="..\..\native_libraries\linux-x64\libgit2-5853918.so" Pack="true" PackagePath="runtimes/linux-x64/native" Visible="false" Condition="Exists('..\..\native_libraries\linux-x64\libgit2-5853918.so')" />
    <None Include="..\..\native_libraries\linux-x64\LICENSE-Libgit2.txt" Pack="true" PackagePath="runtimes/linux-x64/native" Visible="false" Condition="Exists('..\..\native_libraries\linux-x64\libgit2-5853918.so')" />
