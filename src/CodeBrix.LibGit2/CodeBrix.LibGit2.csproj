    <None Include="..\..\native_libraries\android-x64\LICENSE-Xdiff.txt" Pack="true" PackagePath="runtimes/android-x64/native" Visible="false" Condition="Exists('..\..\native_libraries\android-x64\libgit2-5853918.so')" />
