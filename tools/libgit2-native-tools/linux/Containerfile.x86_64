# =============================================================================================
# Containerfile.x86_64 - the libgit2 build machine for linux-x64
# =============================================================================================
#
# WHAT THIS IS, AND WHY IT IS A SEPARATE STEP
#   The rule this folder exists for says the LIBRARY BUILD may not reach outside this
#   repository. Tools installed on a build machine are the one allowed exception - and this
#   file IS that installation, written down and version-pinned: it takes the digest-pinned
#   manylinux base image (AlmaLinux 8, gcc 14, glibc 2.28) and adds cmake, ninja and `file`. Nothing else.
#
#   Building this image is the ONLY step that uses the network. The library build afterwards
#   runs with `--network none` and cannot reach anything even if it wanted to.
#
#   build.sh builds this image the first time it is needed and reuses it after that.
#   To rebuild deliberately:   FORCE_IMAGE_REBUILD=1 ./build.sh x64
#
# WHY NO -devel PACKAGES. libgit2 is configured with every dependency bundled (zlib, PCRE2,
# llhttp, xdiff, ntlmclient, SHA-1 collision detection) and with USE_HTTPS=OpenSSL-Dynamic,
# which declares the OpenSSL types and prototypes it uses itself and dlopen()s libssl at RUN
# time. Nothing needs a header from this image's repositories. (The base image happens to
# carry pcre-devel and zlib-devel for its CPython builds; pins.env pins REGEX_BACKEND=builtin
# and USE_BUNDLED_ZLIB=ON so neither is ever picked up, and the gate in container-build.sh
# proves the shipped .so needs nothing beyond glibc.)
#
# EVERY VERSION HERE COMES FROM pins.env. The defaults below exist only so a hand-run
# `podman build -f Containerfile.x86_64 .` still works; build.sh always passes --build-arg.
# =============================================================================================

ARG BASE_IMAGE=quay.io/pypa/manylinux_2_28_x86_64@sha256:a61875a2f84cab7df8de222ff12cabc08ff86eb4ad402ac90ba7bdaed9600cca
FROM ${BASE_IMAGE}

ARG CMAKE_VERSION=4.4.3
ARG NINJA_VERSION=1.13.2
ARG PYTHON_IN_IMAGE=/opt/python/cp313-cp313/bin/python

LABEL org.opencontainers.image.title="codebrix-libgit2-build-x86_64"
LABEL org.opencontainers.image.description="libgit2 native build machine: quay.io/pypa/manylinux_2_28_x86_64 + cmake + ninja"
LABEL org.opencontainers.image.source="CodeBrix.LibGit2/tools/libgit2-native-tools/linux/Containerfile.x86_64"

# ---------------------------------------------------------------------------------------------
# 1. Distro packages: `file` for the gate (binutils - readelf, nm, objdump, strings, strip -
#    already comes with the image's gcc toolset).
# ---------------------------------------------------------------------------------------------
RUN set -eux; \
    command -v dnf > /dev/null 2>&1 || { echo "ERROR: no dnf in this image." >&2; exit 1; }; \
    dnf install -y --setopt=install_weak_deps=False file; \
    dnf clean all

# ---------------------------------------------------------------------------------------------
# 2. cmake + ninja, at the pinned versions, from the image's own CPython.
# ---------------------------------------------------------------------------------------------
RUN set -eux; \
    "${PYTHON_IN_IMAGE}" -m pip install --no-cache-dir "cmake==${CMAKE_VERSION}" "ninja==${NINJA_VERSION}"; \
    ln -sf "$(dirname "${PYTHON_IN_IMAGE}")/cmake" /usr/local/bin/cmake; \
    ln -sf "$(dirname "${PYTHON_IN_IMAGE}")/ninja" /usr/local/bin/ninja

# ---------------------------------------------------------------------------------------------
# 3. Prove the toolchain. A missing or too-old tool fails the IMAGE build, here, where the
#    message is obvious - not ten minutes into a library build. The probe compiles and RUNS a
#    C program that dlopen()s libc, the same mechanism the gate's smoke test relies on.
# ---------------------------------------------------------------------------------------------
RUN set -eux; \
    echo "=== toolchain in codebrix-libgit2-build-x86_64 ==="; \
    grep -m1 PRETTY_NAME /etc/os-release; \
    uname -m; \
    cc --version | sed -n 1p; \
    ld --version | sed -n 1p; \
    ldd --version | sed -n 1p; \
    cmake --version | sed -n 1p; \
    ninja --version; \
    for t in file readelf nm objdump strings strip; do command -v "$t"; done; \
    printf '#include <dlfcn.h>\n#include <stdio.h>\nint main(void){ void *h = dlopen("libc.so.6", RTLD_NOW); printf("dlopen(libc.so.6): %%s\\n", h ? "ok" : dlerror()); return h ? 0 : 1; }\n' > /tmp/probe.c; \
    cc -std=c11 -o /tmp/probe /tmp/probe.c -ldl; \
    /tmp/probe; \
    echo "toolchain: ok"

WORKDIR /work
