# ==============================================================================================
# pins.env - EVERY version / digest / option pin used by tools/libgit2-native-tools/linux.
# Edit here only. build.sh and container-build.sh both source this file and echo the resolved
# values at the top of every run, so a build log always says exactly what it used.
# ==============================================================================================

# --- Container images -------------------------------------------------------------------------
# The manylinux images exist to fix the glibc baseline. Building on a modern desktop distro
# bakes THAT distro's glibc version into the .so, and glibc symbol versioning is forward-only,
# so the library would then refuse to load on anything older - a failure that only shows up on
# a user's machine.
#
#   image                                  glibc  runs on
#   manylinux_2_28_x86_64                  2.28   Debian 10+, Ubuntu 20.04+, RHEL 8+
#   manylinux_2_28_aarch64                 2.28   every 64-bit Raspberry Pi OS, Ubuntu 20.04+
#   manylinux_2_39_riscv64                 2.39   Ubuntu 24.04+, Debian 13+ (in practice every
#                                                 riscv64 distro is newer than this)
#
# These are the same three images, at the same dated tag and the same digests, that
# CodeBrix.Sdl3, CodeBrix.VideoPlayback.Dav1d, CodeBrix.Ollama and CodeBrix.Audio pin, so every
# CodeBrix Linux native comes from one base userland. The digest is what the build actually
# pins: the dated tag is there so a human can see which image generation it is, but the FROM
# line in every Containerfile resolves to the digest, so an upstream retag cannot silently
# change the toolchain under a rebuild.
IMAGE_X64=quay.io/pypa/manylinux_2_28_x86_64:2026.07.19-1
IMAGE_X64_DIGEST=sha256:a61875a2f84cab7df8de222ff12cabc08ff86eb4ad402ac90ba7bdaed9600cca
IMAGE_ARM64=quay.io/pypa/manylinux_2_28_aarch64:2026.07.19-1
IMAGE_ARM64_DIGEST=sha256:162c81dfd3efc710732a571717d3c916a6945ebf279e879ddee3243af96fe46f
IMAGE_RISCV64=quay.io/pypa/manylinux_2_39_riscv64:2026.07.19-1
IMAGE_RISCV64_DIGEST=sha256:04b3acc69a6cebb10ac1252587d202acce6445d91c783d3f92229bb2b2483069

# The derived images this tooling builds ON TOP of those (base + cmake + ninja + `file`).
# Building one is the documented "install the tools on the build machine" step and is the ONLY
# step that uses the network; the actual library build then runs with --network none.
DERIVED_IMAGE_PREFIX=codebrix-libgit2-build

# --- Build tools installed into the derived images ---------------------------------------------
# cmake and ninja as PyPI wheels, pinned exactly (the same pins as CodeBrix.Sdl3's
# sdl3-native-tools and CodeBrix.Ollama's llama-native-tools, which proved riscv64 wheels exist
# for both). They are installed from the manylinux image's own CPython (PYTHON_IN_IMAGE).
# libgit2 1.8.6 needs cmake >= 3.5.1.
CMAKE_VERSION=4.4.3
NINJA_VERSION=1.13.2
PYTHON_IN_IMAGE=/opt/python/cp313-cp313/bin/python

# NO -devel PACKAGES ARE INSTALLED, ON PURPOSE. libgit2 is built with every dependency bundled
# (zlib, PCRE2, llhttp, xdiff, ntlmclient, SHA-1 collision detection all come from
# libgit2/deps or libgit2/src) and with HTTPS=OpenSSL-Dynamic, which declares the handful of
# OpenSSL types and prototypes it needs itself (src/libgit2/streams/openssl_dynamic.h,
# src/util/hash/openssl.h, deps/ntlmclient/crypt_openssl.h) and dlopen()s libssl / libcrypto at
# RUN time. So no OpenSSL headers are needed at compile time either - openssl-devel would only
# let CMake's find_package(OpenSSL) succeed, and with OpenSSL-Dynamic nothing uses the result.

# --- Vendored source (in-repo; nothing is fetched at build time) --------------------------------
LIBGIT2_DIR=libgit2
LIBGIT2_VERSION=1.8.6
LIBGIT2_COMMIT=5853918c4c6a7b12f8becf4bd11ff4362ebb9020
LIBGIT2_COMMIT_SUBJECT="v1.8.6: update version numbers"
LIBGIT2_SHORT=5853918

# --- The shipped library ----------------------------------------------------------------------
# The file keeps upstream LibGit2Sharp.NativeBinaries' name, commit suffix included
# (-DLIBGIT2_FILENAME=git2-5853918), so it can never collide with upstream LibGit2Sharp or a
# system libgit2 loaded into the same process. CMake produces libgit2-5853918.so.1.8.6 plus the
# symlinks libgit2-5853918.so.1.8 and libgit2-5853918.so; the package ships ONE regular file
# named libgit2-5853918.so, exactly as upstream's build.libgit2.sh copies it. The SONAME
# (libgit2-5853918.so.1.8) stays inside the file, as built.
LIBGIT2_FILENAME=git2-5853918
LIB_NAME=libgit2-5853918.so
LIB_SONAME=libgit2-5853918.so.1.8
LICENSE_FILE_NAME=LICENSE-Libgit2.txt

# --- libgit2 CMake options ----------------------------------------------------------------------
# UPSTREAM'S FLAGS, VERBATIM - libgit2sharp.nativebinaries build.libgit2.sh, non-Darwin branch
# (a copy is in ../reference-upstream/build.libgit2.sh):
#   -DCMAKE_BUILD_TYPE=Release
#   -DBUILD_TESTS=OFF
#   -DUSE_SSH=exec                 SSH by running the system `ssh` binary (no libssh2)
#   -DLIBGIT2_FILENAME=git2-5853918
#   -DUSE_HTTPS=OpenSSL-Dynamic    libssl / libcrypto dlopen()ed at run time; never NEEDED
#   -DUSE_BUNDLED_ZLIB=ON          deps/zlib compiled in
# (upstream also passes -DCMAKE_OSX_ARCHITECTURES=$(uname -m), which CMake ignores on Linux and
#  which is therefore not repeated here.)
#
# ADDITIONS, each for a stated reason:
#   -GNinja                        (set by container-build.sh) the generator; no effect on output
#   -DREGEX_BACKEND=builtin        REQUIRED BY THE IMAGE. The manylinux images ship pcre-devel
#                                  (PCRE 8.x, for their CPython builds). libgit2's
#                                  cmake/SelectRegex.cmake picks a system PCRE whenever
#                                  find_package(PCRE) succeeds, which would link libpcre.so.1
#                                  into the library - a NEEDED dependency the user's machine may
#                                  not have, and a different regex engine from upstream's build.
#                                  "builtin" is the bundled PCRE2 in deps/pcre2, which is what
#                                  upstream's image (no pcre-devel) selects by default. Same
#                                  result as upstream, stated instead of left to the image.
#   CMAKE_C_FLAGS / linker flags   (set by container-build.sh) -g, -ffile-prefix-map for the
#                                  scratch paths, -Wl,--build-id=sha1 - reproducibility and the
#                                  unstripped twin; no effect on the generated code.
LIBGIT2_CMAKE_OPTIONS="-DCMAKE_BUILD_TYPE=Release -DBUILD_TESTS=OFF -DUSE_SSH=exec -DLIBGIT2_FILENAME=git2-5853918 -DUSE_HTTPS=OpenSSL-Dynamic -DUSE_BUNDLED_ZLIB=ON -DREGEX_BACKEND=builtin"

# The lines libgit2's own CMake feature summary MUST contain ("-- * <name>, <description>" in the
# "Enabled features" block; the full summary is copied into BUILD-INFO.txt). A build whose summary lacks one fails the gate: it means a backend
# changed under us (a different image, a different libgit2), which must be a decision, not an
# accident. One pattern per line; each is a fixed string matched against the summary.
REQUIRED_FEATURES="threadsafe, threadsafe support
nanoseconds, support nanosecond precision file mtimes and ctimes
HTTPS, using OpenSSL-Dynamic
SHA1, using CollisionDetection
SHA256, using OpenSSL-Dynamic
http-parser, using bundled parser
regex, using bundled PCRE
xdiff, xdiff support (bundled)
SSH, using OpenSSH exec support
zlib, using bundled zlib
ntlmclient, NTLM authentication support for Unix"

# --- Verification gate ---------------------------------------------------------------------------
# The highest GLIBC_x.y symbol version the shipped .so may reference. This IS the oldest system
# the binary can load on, so it is checked, not merely reported.
GLIBC_MAX_X64=2.28
GLIBC_MAX_ARM64=2.28
GLIBC_MAX_RISCV64=2.39

# Shared libraries the .so is allowed to depend on: glibc and its loader, nothing else. libssl /
# libcrypto (dlopen()ed - OpenSSL-Dynamic), libz (bundled), libpcre / libpcre2 (bundled),
# libssh2 (SSH is `ssh` exec) and libhttp_parser / libllhttp (bundled) must all be ABSENT; the
# gate names them explicitly if one ever appears.
ALLOWED_DEPS="libc.so.6 libm.so.6 libpthread.so.0 libdl.so.2 librt.so.1 ld-linux-x86-64.so.2 ld-linux-aarch64.so.1 ld-linux-riscv64-lp64d.so.1"
FORBIDDEN_DEP_PATTERN='^(libssl|libcrypto|libz|libpcre|libssh|libhttp_parser|libllhttp|libgssapi|libkrb5|libiconv)'

# Functions the shipped library must export (a sample of the C API the managed wrapper calls;
# the full export count is recorded in BUILD-INFO.txt).
REQUIRED_SYMBOLS="git_libgit2_version git_libgit2_features git_libgit2_init git_libgit2_shutdown git_libgit2_opts git_error_last git_repository_open git_repository_init git_repository_free git_clone git_remote_connect git_remote_fetch git_remote_push git_commit_create git_index_add_bypath git_diff_tree_to_tree git_odb_hash git_oid_tostr_s git_blob_create_from_buffer git_status_list_new"

# Sonames that must appear in the binary as dlopen() targets: the OpenSSL libraries that
# OpenSSL-Dynamic probes at run time (libgit2 1.8.6 src/libgit2/streams/openssl_dynamic.c). A
# missing one means the dynamic TLS backend was not compiled in.
REQUIRED_DLOPEN_SONAMES="libssl.so.1.1 libssl.so.3 libssl.so.10 libssl.so.1.0.0"

# The git_libgit2_features() bit mask the smoke test must read back:
# THREADS (1) | HTTPS (2) | SSH (4) | NSEC (8) = 15 - the same mask upstream's 2.0.324
# linux-x64 binary reports.
EXPECTED_FEATURES=15
